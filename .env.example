# Копирай този файл като .env и попълни ключовете си.
# .env НЕ се качва в GitHub (в .gitignore е).

# API ключ от https://platform.claude.com/ -> API Keys
ANTHROPIC_API_KEY=

# API ключ от https://console.deepgram.com/ -> API Keys
DEEPGRAM_API_KEY=

# Порт на локалния сървър (по избор, по подразбиране 3000)
PORT=
